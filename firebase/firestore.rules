rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validHouse() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.species in ['red_feather', 'black_feather', 'broiler', 'layer', 'other']
        && request.resource.data.designCapacity is int
        && request.resource.data.designCapacity > 0
        && request.resource.data.designCapacity <= 1000000
        && request.resource.data.currentBirdCount is int
        && request.resource.data.currentBirdCount >= 0
        && request.resource.data.currentBirdCount <= request.resource.data.designCapacity
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function ownsVisitProgress(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function validVisitProgress(ownerUid) {
      return request.resource.data.ownerUid == ownerUid
        && request.resource.data.accumulatedDays is int
        && request.resource.data.accumulatedDays >= 0
        && request.resource.data.streakDays is int
        && request.resource.data.streakDays >= 0
        && (request.resource.data.lastVisitDate == null || request.resource.data.lastVisitDate is string)
        && request.resource.data.equipped is map
        && request.resource.data.updatedAt is string;
    }

    function validMarketRecord() {
      return request.resource.data.item is string
        && request.resource.data.label is string
        && (request.resource.data.value == null || request.resource.data.value is number)
        && request.resource.data.sourceDate is string
        && request.resource.data.frequency in ['daily', 'weekly', 'monthly']
        && request.resource.data.unit == 'TWD_PER_600G'
        && request.resource.data.sourceName is string
        && request.resource.data.sourceUrl is string
        && request.resource.data.rawSnapshotHash is string
        && request.resource.data.parserVersion is string;
    }

    function validOfficialAutoMarketRecord(recordId) {
      return validMarketRecord()
        && request.resource.data.keys().hasOnly([
          'id', 'item', 'label', 'value', 'unit', 'frequency', 'sourceDate',
          'sourcePublishedAt', 'fetchedAt', 'sourceName', 'sourceUrl', 'status',
          'rawSnapshotHash', 'parserVersion', 'validationStatus', 'capturedAt'
        ])
        && request.resource.data.item in [
          'red_north_male', 'red_north_female', 'red_central_male',
          'red_central_female', 'red_south_male', 'red_south_female',
          'black_south_male', 'black_south_female', 'broiler_large',
          'broiler_medium', 'broiler_store_kp', 'egg_transport', 'egg_producer'
        ]
        && request.resource.data.id == request.resource.data.sourceDate + ':' + request.resource.data.item
        && recordId == request.resource.data.sourceDate + '__' + request.resource.data.item
        && (request.resource.data.value == null
          || (request.resource.data.value >= 0 && request.resource.data.value <= 500))
        && request.resource.data.sourceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.sourcePublishedAt == null
        && request.resource.data.fetchedAt is string
        && request.resource.data.frequency == 'daily'
        && request.resource.data.sourceName == '農業部 Open Data'
        && request.resource.data.sourceUrl.matches('^https://data[.]moa[.]gov[.]tw/api/v1/.*$')
        && request.resource.data.status == 'verified-live'
        && request.resource.data.rawSnapshotHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.parserVersion == 'moa-poultry-v1.0.0'
        && request.resource.data.validationStatus == 'valid'
        && request.resource.data.capturedAt is string;
    }

    match /public_houses/{houseId} {
      allow read: if true;
      allow create: if isAdmin() && validHouse();
      allow update: if isAdmin() && validHouse()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /investment_houses/{houseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /investment_ledger/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /market_history/{recordId} {
      allow read: if true;
      allow create: if signedIn() && validOfficialAutoMarketRecord(recordId);
      allow update, delete: if false;
    }

    match /visit_progress/{ownerUid} {
      allow read: if ownsVisitProgress(ownerUid);
      allow create, update: if ownsVisitProgress(ownerUid) && validVisitProgress(ownerUid);
      allow delete: if false;

      match /days/{date} {
        allow read: if ownsVisitProgress(ownerUid);
        allow create: if ownsVisitProgress(ownerUid)
          && request.resource.data.date == date
          && request.resource.data.recordedAt is string;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
